{
  "manifest_version": 3,
  "name": "Amazon Referral Tag",
  "version": "1.0",
  "description": "Automatically applies your Amazon Associates referral tag on every Amazon page.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["*://*.amazon.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "main_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
